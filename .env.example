# ---------------- Backend ----------------
# Comma-separated key pool (>= 2). Key ids are key_1, key_2, ... in this order.
# Free keys: Google AI Studio (https://aistudio.google.com/apikey) and/or Groq (https://console.groq.com/keys).
# Tip: Gemini quotas are per Google Cloud *project*, so create each Gemini key in a different project.
LLM_API_KEYS=your-first-api-key,your-second-api-key

# Default LiteLLM model for every key.
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional: per-key model override, same order as LLM_API_KEYS (empty entry = LLM_MODEL).
# Example mixing providers (key_1 = Gemini, key_2 = Groq):
# LLM_KEY_MODELS=gemini/gemini-3.5-flash-lite,groq/llama-3.1-8b-instant
LLM_KEY_MODELS=

# SQLite location (inside the Docker volume mounted at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins (your deployed frontend URL). "*" allows any origin.
ALLOWED_ORIGINS=http://localhost:3000

# true enables the X-Simulate-Failure test header
ENABLE_FAILURE_SIMULATION=true

# Response cache (LiteLLM in-memory cache)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# LLM call tuning
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=1024
# How many previous messages are sent as context
MAX_HISTORY_MESSAGES=20
# DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

LOG_LEVEL=INFO
# Expose FastAPI /docs (off by default so only the 3 contract endpoints exist)
ENABLE_DOCS=false

# ---------------- Frontend ----------------
# Backend URL the browser calls. Docker: read at container start. Vercel/Netlify: set VITE_API_URL instead.
PUBLIC_API_URL=http://localhost:8000
